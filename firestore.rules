rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function existingData() {
      return resource.data == null ? {} : resource.data;
    }

    function legacyServerOnlyFields() {
      return ['stats', 'verified'];
    }

    // Returns true if a new document omits fields that are exclusively managed
    // by Cloud Functions or the Admin SDK.
    function doesNotSetServerOnlyFieldsOnCreate() {
      let serverOnlyFields = [
        // Phase 1 server-only fields
        'age',
        'banned',
        'banReason',
        'bannedAt',
        // Phase 2 server-only fields
        'photoVerified',
        'verifiedAt',
        'stripeCustomerId',
        'premium',
        'boost',
        'boostExpiresAt',
        'gymCheckin',
        // Legacy Phase 1 field — client still sees it in normalised reads
        // but must not write it
        'subscription'
      ];
      return !request.resource.data.keys().hasAny(serverOnlyFields);
    }

    function doesNotSetLegacyServerOnlyFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(legacyServerOnlyFields());
    }

    // Returns true if an update attempts to change any field that is exclusively
    // managed by Cloud Functions or the Admin SDK.
    // Phase 2 expands this root-level list beyond Phase 1 to include premium
    // and verification fields. Nested Strava token fields are checked
    // separately on the /users update rule.
    function doesNotModifyServerOnlyFields() {
      let serverOnlyFields = [
        // Phase 1 server-only fields
        'age',
        'banned',
        'banReason',
        'bannedAt',
        // Phase 2 server-only fields
        'photoVerified',
        'verifiedAt',
        'stripeCustomerId',
        'premium',
        'boost',
        'boostExpiresAt',
        // Legacy Phase 1 field — client still sees it in normalised reads
        // but must not write it
        'subscription'
      ];
      return !request.resource.data.diff(existingData())
              .affectedKeys()
              .hasAny(serverOnlyFields);
    }

    function doesNotModifyLegacyServerOnlyFields() {
      return !request.resource.data.diff(existingData())
              .affectedKeys()
              .hasAny(legacyServerOnlyFields());
    }

    function doesNotModifyGymCheckinExceptDelete() {
      return !request.resource.data.diff(existingData())
              .affectedKeys()
              .hasAny(['gymCheckin'])
             || !request.resource.data.keys().hasAny(['gymCheckin']);
    }

    function fitnessTrackingOnCreate() {
      return request.resource.data.get('fitnessTracking', {});
    }

    function stravaOnCreate() {
      return fitnessTrackingOnCreate().get('strava', {});
    }

    function stravaCreateKeys() {
      return stravaOnCreate().keys();
    }

    function isStravaCreateDisconnectOnly() {
      return stravaCreateKeys().hasOnly(['connected', 'lastSync'])
             && (
               !stravaCreateKeys().hasAny(['connected'])
               || stravaOnCreate().get('connected', false) == false
             )
             && (
               !stravaCreateKeys().hasAny(['lastSync'])
               || stravaOnCreate().get('lastSync', 'missing') == null
             );
    }

    function doesNotSetServerManagedFitnessFieldsOnCreate() {
      return !request.resource.data.keys().hasAny(['fitnessTracking'])
             || (
               fitnessTrackingOnCreate() is map
               && (
                 !fitnessTrackingOnCreate().keys().hasAny(['strava'])
                 || (
                   stravaOnCreate() is map
                   && isStravaCreateDisconnectOnly()
                 )
               )
             );
    }

    function fitnessTrackingBefore() {
      return existingData().get('fitnessTracking', {});
    }

    function fitnessTrackingAfter() {
      return request.resource.data.get('fitnessTracking', {});
    }

    function stravaBefore() {
      return fitnessTrackingBefore().get('strava', {});
    }

    function stravaAfter() {
      return fitnessTrackingAfter().get('strava', {});
    }

    function hasValidFitnessTrackingMap() {
      return fitnessTrackingBefore() is map
             && fitnessTrackingAfter() is map;
    }

    function hasValidStravaMap() {
      return stravaBefore() is map
             && stravaAfter() is map;
    }

    function fitnessTrackingAffectedKeys() {
      return fitnessTrackingAfter().diff(fitnessTrackingBefore()).affectedKeys();
    }

    function stravaAffectedKeys() {
      return stravaAfter().diff(stravaBefore()).affectedKeys();
    }

    function isStravaClientDisconnectOnly() {
      return stravaAffectedKeys().hasOnly(['connected', 'lastSync'])
             && (
               !stravaAffectedKeys().hasAny(['connected'])
               || stravaAfter().get('connected', false) == false
             )
             && (
               !stravaAffectedKeys().hasAny(['lastSync'])
               || stravaAfter().get('lastSync', 'missing') == null
             );
    }

    function doesNotModifyStravaTokenFields() {
      return !request.resource.data.diff(existingData())
              .affectedKeys()
              .hasAny([
                'fitnessTracking.strava.accessToken',
                'fitnessTracking.strava.refreshToken',
                'fitnessTracking.strava.expiresAt'
              ]);
    }

    function doesNotModifyStravaMapExceptDisconnect() {
      return !request.resource.data.diff(existingData()).affectedKeys()
               .hasAny(['fitnessTracking'])
             || (
               hasValidFitnessTrackingMap()
               && (
                 !fitnessTrackingAffectedKeys().hasAny(['strava'])
                 || (
                   hasValidStravaMap()
                   && isStravaClientDisconnectOnly()
                 )
               )
             );
    }

    // Returns true if a user is a participant in the given match document.
    // Used to gate match reads; not used in discovery hot path.
    function isMatchParticipant(matchId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/matches/$(matchId)).data.users;
    }


    // ─── /users/{userId} ────────────────────────────────────────────────────

    match /users/{userId} {

      // Any authenticated user can read any profile.
      // Required for: discovery stack display, chat header, profile modal,
      // match card resolution in matchStore.
      allow read: if isSignedIn();

      // New user document creation:
      //   - Only the authenticated user can create their own document.
      //   - Server-only fields must be absent on creation (Cloud Functions
      //     write them after the document is created).
      allow create: if isOwner(userId)
                    && doesNotSetServerOnlyFieldsOnCreate()
                    && doesNotSetLegacyServerOnlyFieldsOnCreate()
                    && doesNotSetServerManagedFitnessFieldsOnCreate();

      // Profile update:
      //   - Only the authenticated user can update their own document.
      //   - Server-only fields (premium, photoVerified, stripeCustomerId, etc.)
      //     are blocked — managed exclusively by Cloud Functions.
      //
      // Client-writable fitnessTracking sub-fields (NOT blocked):
      //   - fitnessTracking.shareOnProfile    ← user preference toggle
      //   - fitnessTracking.appleHealth.*     ← permission grant/revoke on iOS
      //   - fitnessTracking.googleFit.*       ← permission grant/revoke on Android
      //
      // Strava token fields (BLOCKED — managed by exchangeStravaToken /
      //   syncStravaActivity Cloud Functions):
      //   - fitnessTracking.strava.accessToken
      //   - fitnessTracking.strava.refreshToken
      //   - fitnessTracking.strava.expiresAt
      //
      // Verification (BLOCKED — managed by verifyProfilePhoto Cloud Function):
      //   - photoVerified
      //   - verifiedAt
      //
      // Premium (BLOCKED — managed by Stripe webhook Cloud Function):
      //   - premium (entire sub-object)
      //   - stripeCustomerId
      //
      // Gym check-in (BLOCKED except delete on checkout):
      //   - gymCheckin is written by createCheckin Cloud Function
      //   - client may only delete gymCheckin when checking out
      allow update: if resource.data != null
                    && isOwner(userId)
                    && doesNotModifyServerOnlyFields()
                    && doesNotModifyLegacyServerOnlyFields()
                    && doesNotModifyGymCheckinExceptDelete()
                    && doesNotModifyStravaTokenFields()
                    && doesNotModifyStravaMapExceptDisconnect();

      // Deletion is handled by the deleteAccount Cloud Function / Admin SDK.
      // Direct client delete is denied.
      allow delete: if false;


      // ── /users/{userId}/dailyLikes (single document: .../dailyLikes/doc) ──

      match /dailyLikes/{docId} {
        // Client reads the dailyLikes count to display remaining likes in the UI.
        // Writes are owned by the recordSwipe Cloud Function (Task 55).
        allow read:   if isOwner(userId);
        allow write:  if false;
      }


      // ── /users/{userId}/notificationPreferences/prefs ────────────────────

      match /notificationPreferences/{docId} {
        // Owner-managed granular push preferences.
        // Absent prefs doc means all notification types are enabled.
        allow read, write: if isOwner(userId);
      }


      // ── /users/{userId}/verificationAttempts (single document) ────────────

      match /verificationAttempts/{docId} {
        // Entirely managed by the verifyProfilePhoto Cloud Function (Task 56).
        // Clients have no read or write access.
        allow read:  if false;
        allow write: if false;
      }

    } // end /users/{userId}


    // ─── /swipes/{userId}/likes/{targetId} ──────────────────────────────────

    match /swipes/{userId}/likes/{targetId} {
      // Reads: the swipe owner (to check their own swipe history) or the target
      // (to check whether a mutual like exists — used by onSwipeCreated trigger
      // and client-side checks).
      allow read: if isSignedIn()
                  && (isOwner(userId) || isOwner(targetId));

      // Writes: DENIED for all clients.
      // All like and superlike writes go through the recordSwipe Cloud Function
      // (Task 55), which enforces the daily limit transactionally.
      // Firestore security rules deny direct client writes so there is no bypass.
      allow write: if false;
    }


    // ─── /swipes/{userId}/passes/{targetId} ─────────────────────────────────

    match /swipes/{userId}/passes/{targetId} {
      // Read: only the swipe owner (to check their own pass history).
      allow read: if isOwner(userId);

      // Write: DENIED for all clients.
      // Pass writes also go through recordSwipe Cloud Function (Task 55).
      allow write: if false;
    }


    // ─── /matches/{matchId} ─────────────────────────────────────────────────

    match /matches/{matchId} {
      // Read: only match participants.
      allow read: if isSignedIn() && isMatchParticipant(matchId);

      // Create: DENIED — match creation is exclusively the responsibility of
      // the onSwipeCreated Cloud Function (Task 24).
      allow create: if false;

      // Update: match participants may update ONLY these chat-metadata fields.
      // This allows ChatScreen to write lastMessage, lastMessageAt, and their
      // own unread counter without a Cloud Function round-trip on every send.
      // The dynamic {userId}_unread field is validated against the authenticated
      // user's UID to prevent cross-user unread tampering.
      allow update: if isSignedIn()
                    && isMatchParticipant(matchId)
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'lastMessage',
                          'lastMessageAt',
                          (request.auth.uid + '_unread')
                        ]);

      // Delete: DENIED — unmatch goes through the unmatchUser Cloud Function
      // (Task 39B).
      allow delete: if false;


      // ── /matches/{matchId}/messages/{messageId} ──────────────────────────

      match /messages/{messageId} {
        // Read: only match participants.
        allow read: if isSignedIn() && isMatchParticipant(matchId);

        // Create: participants may write new messages; sender must be themselves.
        allow create: if isSignedIn()
                      && isMatchParticipant(matchId)
                      && isOwner(request.resource.data.senderId);

        // Update/delete: denied.
        allow update: if false;
        allow delete: if false;
      }

    } // end /matches/{matchId}


    // ─── /reports/{reportId} ────────────────────────────────────────────────

    match /reports/{reportId} {
      // Create: any authenticated user may file a report.
      // The reporterId must match their own UID (no impersonation).
      allow create: if isSignedIn()
                    && isOwner(request.resource.data.reporterId);

      // Read/update/delete: denied for clients.
      // Report review and actioning is admin-only via Firebase Console or
      // the Admin SDK.
      allow read:   if false;
      allow update: if false;
      allow delete: if false;
    }


    // ─── /blocked/{userId} ──────────────────────────────────────────────────

    match /blocked/{userId}/{document=**} {
      // Entirely managed by Cloud Functions (unmatchUser, recordSwipe).
      // No client reads or writes.
      allow read:  if false;
      allow write: if false;
    }


    // ─── /gymCheckins/{checkinId} ───────────────────────────────────────────

    match /gymCheckins/{checkinId} {
      // Check-in creation is owned by the createCheckin Cloud Function.
      allow create: if false;

      // Users may read and delete only their own active check-in document.
      allow read: if isSignedIn()
                  && request.auth.uid == resource.data.userId;
      allow delete: if isSignedIn()
                    && request.auth.uid == resource.data.userId;

      // Check-in fields are server-managed after creation.
      allow update: if false;
    }


    // ─── /events/{eventId} ─────────────────────────────────────────────────

    match /events/{eventId} {
      // Event creation is owned by the createEvent Cloud Function.
      allow create: if false;

      // Any authenticated user can discover and open workout events.
      allow read: if isSignedIn();

      // Creator may update only creator-editable fields. Attendees are mutated
      // exclusively by the rsvpEvent Cloud Function.
      allow update: if resource.data != null
                    && isSignedIn()
                    && request.auth.uid == resource.data.creatorId
                    && request.resource.data.diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          'title',
                          'description',
                          'maxAttendees',
                          'cancelled'
                        ]);

      // Hard deletes are denied; cancellation is a soft delete.
      allow delete: if false;
    }


    // ─── /admin_queue/{docId} ──────────────────────────────────────────────

    match /admin_queue/{docId} {
      allow read, write: if false;
    }


    // ─── /flags/{docId} ────────────────────────────────────────────────────

    match /flags/{docId} {
      allow read, write: if false;
    }


    // ─── Default catch-all ──────────────────────────────────────────────────

    // Any collection not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
